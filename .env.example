PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
API_ORIGIN=http://127.0.0.1:5173
# Local development fallback. Production uses the dedicated Turso database.
DATABASE_PATH=folio.sqlite
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional one-time migration of the old global workspace to its verified Google owner.
LEGACY_OWNER_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -hex 32 (64 hex characters)
TOKEN_ENCRYPTION_KEY=

# Private Cloud Storage fallback for users without a Drive connection.
UPLOAD_BUCKET=

# Apple native login. Keep the private key only in local .env / Secret Manager.
APPLE_CLIENT_ID=studio.folio.app
APPLE_TEAM_ID=G28EXCQ6J5
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
