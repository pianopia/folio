{
  "expo": {
    "name": "Folio",
    "slug": "folio-artwork",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "studio.folio.app",
      "buildNumber": "1",
      "appleTeamId": "G28EXCQ6J5",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "studio.folio.app",
      "versionCode": 1
    },
    "platforms": [
      "ios",
      "android"
    ],
    "owner": "pianopia",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "作品としてアップロードする写真を選択するために使用します。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "a543c297-2209-449f-9d4d-162524fa6300"
      }
    }
  }
}
