{
  "name": "folio",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter \"@folio/api\" --filter \"@folio/web\" dev",
    "build": "bun run --filter @folio/web build",
    "check": "bun run --filter @folio/web check && bun run --filter @folio/mobile check && tsc --noEmit -p apps/api/tsconfig.json",
    "test": "bun test apps/api"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/bun": "latest",
    "react": "18.3.1",
    "@types/react": "^18.3.31"
  }
}
